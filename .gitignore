# Secrets
.env

# Python
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# Large raw downloads: kept locally, provenance in data/raw/*/SOURCE.md
data/raw/dwr_crop_mapping/*
!data/raw/dwr_crop_mapping/SOURCE.md
data/raw/cimis/*.json
!data/raw/cimis/SOURCE.md

# Regenerable derived caches: the GeoPackage is rebuilt from data/raw in seconds, and
# the rasters are Earth Engine downloads. The small CSV tables ARE committed.
data/derived/*.tif
data/derived/*.tiff
data/derived/*.gpkg
data/derived/_tmp_*

# OS
Thumbs.db
.DS_Store
